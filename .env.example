# =====================================================
# AI API Keys - digunakan oleh semua fitur AI:
#  - Auto Label AI (Manajemen Kode Inventaris)
#  - Rekomendasi AI (Pemeliharaan Preventif)
#  - Saran Nama Item (Form Tambah Barang)
#
# Copy file ini ke .env dan isi salah satu key di bawah.
# Priority: Gemini -> OpenRouter -> Cerebras
# =====================================================

# Google Gemini API Key (AI Studio - gratis)
# Dapatkan di: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter API Key (akses berbagai model gratis)
# Dapatkan di: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Cerebras API Key (llama3.1-8b)
# Dapatkan di: https://cloud.cerebras.ai/
VITE_CEREBRAS_API_KEY=

# API Backend URL (default: /public/api via Docker proxy)
VITE_API_BASE_URL=/public/api
